# BrickKit Market 部署环境变量模板（运维指南 §4.3）。
#
#   cp .env.example .env && chmod 600 .env
#
# ⚠️ .env 含明文口令，不要提交 Git。全部口令请用随机生成，不要用示例值。

# ===== PostgreSQL =====
POSTGRES_USER=brickkit_market
POSTGRES_PASSWORD=换成强口令
POSTGRES_DB=brickkit_market

# ===== 对象存储（RustFS / 任何 S3 兼容服务）=====
RUSTFS_ACCESS_KEY=换成随机串
RUSTFS_SECRET_KEY=换成强口令
RUSTFS_BUCKET=brickkit-artifacts
RUSTFS_REGION=us-east-1

# ===== Market API =====
# 管理员账号：首次启动自动创建。已存在时只补管理员权限，**不覆盖口令**
ADMIN_USERNAME=admin
ADMIN_PASSWORD=换成强口令（至少 8 位）

# 登录令牌有效期（小时），默认 30 天
JWT_EXPIRY_HOURS=720

# 忘记管理员口令时：改上面的 ADMIN_PASSWORD，把这里置 true，重启一次，再改回 false
ADMIN_PASSWORD_RESET=false

# ===== 端口（宿主机侧，按需改）=====
MARKET_PORT=8080
RUSTFS_CONSOLE_PORT=9001

# ===== 镜像 =====
# 用现成镜像时填仓库地址；本地从源码构建时执行 docker compose up -d --build
MARKET_IMAGE=brickkit/market-server:dev
MARKET_VERSION=dev
