# 市场在 K8s 上的口令。用法：cp .env.example .env && vi .env
#
# 这个文件被 kustomize 的 secretGenerator 读进 Secret，**不要提交 Git**
# （deploy/market/k8s/*/.env 已在 .gitignore 里）。
#
# 非敏感的配置（数据库地址、库名、用户名…）不在这里，
# 在 kustomization.yaml 的 configMapGenerator 里。

DATABASE_PASSWORD=<改成一个强口令>
RUSTFS_ACCESS_KEY=<改成一个 access key>
RUSTFS_SECRET_KEY=<改成一个强口令>
ADMIN_PASSWORD=<改成一个强口令>
