# BrickKit 本地开发环境变量模板
#
# 用法：cp .env.example .env 然后填入真实值。
# .env 含密钥，已被 .gitignore 忽略，绝不提交（003 §5.4、008 §6）。
#
# brickkit.yaml 中通过 ${ENV_VAR} 引用这些变量，CLI 在解析配置时展开；
# 变量未设置时 CLI 保留 ${VAR} 原样，便于发现漏配。

# ===== PostgreSQL（市场后端 + 组件数据库）=====
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=<你的数据库密码>
POSTGRES_DB=brickkit_market

# ===== RustFS（S3 兼容对象存储，存放组件 artifacts）=====
RUSTFS_ENDPOINT=http://localhost:9000
RUSTFS_ACCESS_KEY=<你的 access key>
RUSTFS_SECRET_KEY=<你的 secret key>
RUSTFS_BUCKET=brickkit-artifacts
RUSTFS_REGION=us-east-1

# ===== 市场访问 Token（brickkit.yaml → sources[].authToken）=====
# 执行过 brickkit login 后 CLI 优先使用 .brickkit/credentials，此项可留空
MARKET_TOKEN=

# ===== Redis（部分组件依赖）=====
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
