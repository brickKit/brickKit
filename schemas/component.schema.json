{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
    "apiVersion": {
      "enum": [
        "brickkit/v1"
      ],
      "type": "string"
    },
    "artifacts": {
      "items": {
        "additionalProperties": false,
        "properties": {
          "description": {
            "type": "string"
          },
          "files": {
            "items": {
              "type": "string"
            },
            "type": "array"
          },
          "format": {
            "type": "string"
          },
          "type": {
            "type": "string"
          }
        },
        "required": [
          "files",
          "type"
        ],
        "type": "object"
      },
      "type": "array"
    },
    "configSchema": {
      "additionalProperties": false,
      "properties": {
        "properties": {
          "additionalProperties": {
            "additionalProperties": false,
            "properties": {
              "default": {},
              "description": {
                "type": "string"
              },
              "enum": {
                "items": {},
                "type": "array"
              },
              "items": {
                "additionalProperties": false,
                "properties": {
                  "type": {
                    "type": "string"
                  }
                },
                "type": "object"
              },
              "maximum": {
                "type": "number"
              },
              "minimum": {
                "type": "number"
              },
              "pattern": {
                "type": "string"
              },
              "secret": {
                "type": "boolean"
              },
              "type": {
                "enum": [
                  "string",
                  "integer",
                  "number",
                  "boolean",
                  "array",
                  "object"
                ],
                "type": "string"
              }
            },
            "required": [
              "type"
            ],
            "type": "object"
          },
          "type": "object"
        },
        "required": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "type": {
          "type": "string"
        }
      },
      "type": "object"
    },
    "dependencies": {
      "additionalProperties": false,
      "properties": {
        "components": {
          "items": {
            "oneOf": [
              {
                "pattern": "^[^@ ]+@[0-9]+[.][0-9]+[.][0-9]+$",
                "type": "string"
              },
              {
                "additionalProperties": false,
                "properties": {
                  "id": {
                    "pattern": "^[^@ ]+@[0-9]+[.][0-9]+[.][0-9]+$",
                    "type": "string"
                  },
                  "optional": {
                    "type": "boolean"
                  }
                },
                "required": [
                  "id"
                ],
                "type": "object"
              }
            ]
          },
          "type": "array"
        },
        "resources": {
          "items": {
            "additionalProperties": false,
            "properties": {
              "engine": {
                "type": "string"
              },
              "kind": {
                "enum": [
                  "database",
                  "cache",
                  "mq",
                  "storage",
                  "search",
                  "smtp"
                ],
                "type": "string"
              }
            },
            "required": [
              "engine",
              "kind"
            ],
            "type": "object"
          },
          "type": "array"
        }
      },
      "type": "object"
    },
    "deployment": {
      "additionalProperties": false,
      "properties": {
        "extraPorts": {
          "items": {
            "additionalProperties": false,
            "properties": {
              "name": {
                "type": "string"
              },
              "port": {
                "maximum": 65535,
                "minimum": 1,
                "type": "integer"
              }
            },
            "required": [
              "name",
              "port"
            ],
            "type": "object"
          },
          "type": "array"
        },
        "image": {
          "type": "string"
        },
        "labels": {
          "additionalProperties": {
            "type": "string"
          },
          "type": "object"
        },
        "port": {
          "maximum": 65535,
          "minimum": 1,
          "type": "integer"
        },
        "resources": {
          "additionalProperties": false,
          "properties": {
            "limits": {
              "additionalProperties": false,
              "properties": {
                "cpu": {
                  "type": "string"
                },
                "memory": {
                  "type": "string"
                }
              },
              "type": "object"
            },
            "requests": {
              "additionalProperties": false,
              "properties": {
                "cpu": {
                  "type": "string"
                },
                "memory": {
                  "type": "string"
                }
              },
              "type": "object"
            }
          },
          "type": "object"
        },
        "type": {
          "enum": [
            "container"
          ],
          "type": "string"
        }
      },
      "required": [
        "image",
        "port",
        "type"
      ],
      "type": "object"
    },
    "healthCheck": {
      "additionalProperties": false,
      "properties": {
        "path": {
          "type": "string"
        },
        "startPeriodSeconds": {
          "type": "integer"
        },
        "type": {
          "enum": [
            "http",
            "tcp",
            "none"
          ],
          "type": "string"
        }
      },
      "required": [
        "type"
      ],
      "type": "object"
    },
    "kind": {
      "enum": [
        "Component"
      ],
      "type": "string"
    },
    "metadata": {
      "additionalProperties": false,
      "properties": {
        "apiDocs": {
          "type": "string"
        },
        "description": {
          "type": "string"
        },
        "id": {
          "type": "string"
        },
        "license": {
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "vendor": {
          "type": "string"
        },
        "version": {
          "pattern": "^[0-9]+[.][0-9]+[.][0-9]+$",
          "type": "string"
        }
      },
      "required": [
        "description",
        "id",
        "name",
        "version"
      ],
      "type": "object"
    },
    "migration": {
      "additionalProperties": false,
      "properties": {
        "command": {
          "items": {
            "type": "string"
          },
          "type": "array"
        }
      },
      "required": [
        "command"
      ],
      "type": "object"
    },
    "tags": {
      "items": {
        "type": "string"
      },
      "type": "array"
    }
  },
  "required": [
    "apiVersion",
    "deployment",
    "healthCheck",
    "kind",
    "metadata"
  ],
  "title": "BrickKit component.yaml",
  "type": "object"
}
